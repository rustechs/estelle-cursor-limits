# Optional overrides loaded by install.sh when rendering the desktop launcher.
# Extra arguments appended after cursor-cgwrap cursor (Wayland on estelle).
CURSOR_DESKTOP_EXTRA_ARGS=--ozone-platform=wayland --enable-features=WaylandWindowDecorations

# Install sysctl drop-in when max_user_watches is below this threshold (set
# SKIP_INOTIFY_SYSCTL=1 to skip). The drop-in itself sets 524288; raise this
# only if you need a higher bar before install tries to apply the template.
CURSOR_INOTIFY_MIN_WATCHES=524288
